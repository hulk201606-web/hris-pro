<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hris</groupId>
        <artifactId>hris-pro</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>hris-common</artifactId>
    <name>hris-common</name>
    <description>公共基础设施：统一响应体 / 错误码 / 异常体系 / traceId / MyBatis-Plus 租户插件 / 审计埋点</description>

    <dependencies>
        <!-- 基础自动配置 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Servlet Web（可选：TraceIdFilter / HttpServletRequest），WebFlux 网关不引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- AOP（审计切面）。Boot 4 起 starter 由 spring-boot-starter-aop 更名为 aspectj -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- MyBatis-Plus Boot4 适配（可选：租户插件/乐观锁/逻辑删），数据层服务引入 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 分页/租户/乐观锁等 inner 插件依赖 jsqlparser（3.5.9+ 拆分为独立模块） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- OpenFeign（可选：PlatformAuditClient 审计落库客户端），只有扫描 com.hris.common.client 的服务需要 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Jackson（可选：AuthContextFilter 解析 JSON 数组格式的 X-User-Perms 头，兼容旧逗号串） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 分布式追踪（docs/21 批 5 D-10）：Micrometer → OpenTelemetry 桥 + OTLP 导出器。
             version 省略：由 spring-boot-starter-parent:4.0.6 BOM 管理（micrometer-tracing 与
             opentelemetry-bom 均在 BOM 内），显式写版本会脱离 BOM 管理。
             未配置 OTEL_EXPORTER_OTLP_ENDPOINT 时不注册导出器（见 OtlpTraceConfig），
             仅内存 span，无 collector 也不报错。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- Boot 4 的 OTel tracing 自动配置（SdkTracerProvider 装配 + 收集 SpanExporter Bean），
             actuator 4.0 起不再内含 tracing 自动配置，须显式引入 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <!-- 排除 okhttp sender（okhttp-jvm 5.x 传递的 okio 新版与 Milvus SDK 的
                 okhttp 4.12/okio 3.6 冲突：Okio.socket NoSuchMethodError）。
                 本项目缺省仅内存 span（未配 OTEL_EXPORTER_OTLP_ENDPOINT），sender
                 不会被实例化；启用 OTLP 导出时需统一 okhttp 版本（见 docs/21）。 -->
            <exclusions>
                <exclusion>
                    <groupId>io.opentelemetry</groupId>
                    <artifactId>opentelemetry-exporter-sender-okhttp</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 用 JDK HttpClient sender 替代被排除的 okhttp sender：
             保持 OTLP 导出能力且不引入 okhttp 5.x/okio 新版（Milvus SDK 冲突源）。 -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-sender-jdk</artifactId>
        </dependency>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
