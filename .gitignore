# Node / Java / Editor
node_modules/
dist/
build/
target/
*.log
.env
.env.*
# 模板必须提交（部署时 cp .env.example .env），不能被上面的通配规则排除
!.env.example
# 前端构建期环境变量必须提交（Vite 靠它注入 mock 开关与 API base，
# 缺失会导致 CI 构建行为不可控）；此处不含任何密钥，纯开关与路径
!frontend/.env
!frontend/.env.*

# OS
.DS_Store
Thumbs.db

# IDEs
.idea/
.vscode/
*.iml

# Mac
*.DS_Store

# Vagrant
.vagrant/

# container
docker-compose.override.yml

# Other
coverage/
reports/

# 本地工作数据（记忆/踩坑记录，不提交）
.workbuddy/

# 本地临时区（截图、构建日志、临时令牌；含真实 JWT，绝不入库）
.tmp/
*.pid

# Java 编译产物
*.class
.mvn/wrapper/maven-wrapper.jar

# ---------- OpenAPI 契约 ----------
# docs/openapi.gen.json **入库**。它是契约漂移检测的基准：
# CI 需要它来验证 frontend/src/api/generated/api.d.ts 是否与契约同步，
# 不入库则这道门禁无法在 CI 中执行（CI 不可能起 10 个 JVM 去重新拉契约）。
# 文件较大（约 640KB），但 JSON 已做 key 排序，diff 只反映真实接口变化。
# 注意：它由 scripts/gen-openapi.py 生成，请勿手工编辑。
