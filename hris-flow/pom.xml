<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.hris</groupId>
        <artifactId>hris-pro</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>hris-flow</artifactId>
    <name>hris-flow</name>
    <description>流程中台(Flowable)/待办中心</description>

    <dependencies>
        <!-- OpenAPI 契约生成（/v3/api-docs）。版本由父 pom 的 springdoc-openapi-bom 统一托管，
             故此处刻意不写 <version>，请勿补——补上即脱离 BOM 管理。生产默认关闭（见
             application.yml 的 springdoc.api-docs.enabled），仅本地/CI 开启。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.hris</groupId>
            <artifactId>hris-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- AOP：hris-common 的 @RequirePerm/PermAspect 需 aspectjweaver 才能生效 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- Feign 负载均衡（openfeign 5.x 不再内置 loadbalancer，需显式引入，见 S0.4 回归） -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <!-- 分页/租户/乐观锁 inner 插件依赖（3.5.9+ 独立模块） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <!-- 参数校验（@Valid / @NotNull 等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Flowable 引擎（Boot4 兼容性为 S0.4 硬门禁，见 docs/04 §8） -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring-boot-starter-process</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 事件总线 producer（FLW-F-012）：rocketmq-spring-boot-starter 2.3.x 传递
             rocketmq-client 5.3.1（与父 pom 版本矩阵的 RocketMQ 5.3.1 对齐）。
             注意：2.3.x 的自动配置只注册在 META-INF/spring.factories，Boot 3+/4 不再加载，
             因此本项目不依赖其自动配置，由 OutboxMqConfig 手动构建 DefaultMQProducer
             （仅在 hris.flow.outbox.mq-enabled=true 时创建）。 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
            <version>2.3.3</version>
            <exclusions>
                <!-- 统一由 Boot BOM 管理日志实现，避免 starter 带入旧版绑定 -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- S0.4 引擎装配验证用内存库（仅 test scope） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
            <!-- 健康检查探针：/actuator/health/liveness|readiness（K8s 就绪/存活探测依赖） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
</dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
