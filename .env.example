# =====================================================================
# 智云 HR 容器化部署环境变量模板
# 用法: cp .env.example .env 后按需修改（.env 已在 .gitignore / .dockerignore 中排除）
# =====================================================================

# ---------- 镜像版本（docker/build-all.sh 与 compose 共用） ----------
APP_VERSION=latest

# ---------- 数据库 ----------
DB_USERNAME=root
# 必填：数据库密码（各服务 ${DB_PASSWORD} 启动即校验）
DB_PASSWORD=
# JDBC 连接目标（各服务 application.yml 只识别整体 DB_URL，不做 HOST/NAME 拼装，
# 因此这里配主机与端口，compose 会为每个服务拼出 jdbc:mysql://host:port/<库名>）
# 用容器内 MySQL（需 docker compose --profile db）时保持 mysql；
# 用本机/外部 MySQL 时改为其地址，例如 127.0.0.1
DB_URL_HOST=mysql
DB_URL_PORT=3306

# ---------- JWT ----------
# 必填：≥32 字节强随机密钥，且各服务必须一致（网关与 auth 同源验签）
# 生成: openssl rand -base64 48
JWT_SECRET=

# ---------- 网关 CORS ----------
# 逗号分隔的允许来源；前端非 5173 端口时必须同步放开（否则浏览器请求被 403）
CORS_ORIGIN=http://localhost:5173

# ---------- 端口映射（宿主机侧；容器内统一 8080） ----------
PORT_GATEWAY=8080

# ---------- RAG / 向量库 ----------
# 不配置时 RAG 降级为占位向量，索引重建链路仍可用；配置后走真实语义向量
DASHSCOPE_API_KEY=
MILVUS_HOST=milvus
MILVUS_PORT=19530