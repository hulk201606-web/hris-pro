# =====================================================================
# hris-pro 备份环境变量模板（只含变量名与说明，绝不写入真实口令）
# 用法：cp 本文件到 /etc/hris-pro/backup.env，填入真实值后 chmod 600
# 依据：docs/18-生产化基线评估与实施计划.md §4.9
# =====================================================================

# 生产 MySQL 口令（必填；backup-mysql.sh 缺失时直接失败，绝不提供默认值）
DB_PASSWORD=

# 备份根目录（可选；默认 /data/backups，下分 mysql/ nacos/ milvus/ minio/）
BACKUP_DIR=/data/backups

# Nacos 导出 API 地址（可选；默认 127.0.0.1:8848）
NACOS_ADDR=127.0.0.1:8848

# MySQL 容器名（可选；默认 hris-mysql）
# MYSQL_CONTAINER=hris-mysql
